              "});",
              "pm.test(\"Corpo da resposta\", function () {",
              "    pm.expect(pm.response.json()).to.eql({\"destination\":{\"id\":\"100\",\"balance\":10}});",
              "});",
              "pm.test(\"Content-Type JSON\", function () {",
